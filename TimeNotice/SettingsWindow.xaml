<Window x:Class="TimeNotice.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TimeNotice Settings" Width="480" Height="760" MinWidth="440" MinHeight="620"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#FAFAFC">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#E5E5EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#111116"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#6B6B74"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#3A3A42"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6"/>
            <Setter Property="BorderBrush" Value="#D5D5DC"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16,16,16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="TimeNotice Settings" FontSize="18" FontWeight="Bold" Foreground="#111116"/>
            <TextBlock Text="Changes apply instantly on Save." FontSize="12" Foreground="#6B6B74"/>
        </StackPanel>

        <TabControl Grid.Row="1" Margin="0,8,0,0">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="General time reminders" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Wall-clock popups on your schedule. Align applies to general reminders only." Style="{StaticResource Hint}"/>
                        <CheckBox x:Name="GeneralEnabledBox" Content="Enabled" IsChecked="True"/>
                        <CheckBox x:Name="StartupBox" Content="Start with Windows"/>
                        <TextBlock Text="Every X minutes" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="IntervalBox" Text="30"/>
                        <CheckBox x:Name="AlignBox" Content="Align to each hour"/>
                        <TextBlock x:Name="AlignWarnText" Foreground="#B45309" FontSize="12" TextWrapping="Wrap" Margin="20,0,0,4" Visibility="Collapsed"/>
                        <CheckBox x:Name="WindowOnlyBox" Content="Only between times"/>
                        <StackPanel x:Name="GeneralTimePanel" Orientation="Horizontal">
                            <StackPanel>
                                <TextBlock Text="From (HH:mm)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="WindowStartBox" Width="110" Margin="0,4,8,4" Text="09:00"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="To (HH:mm)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="WindowEndBox" Width="110" Margin="0,4,0,4" Text="23:00"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Game">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Game session reminders" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Uses its own interval while a listed game is focused." Style="{StaticResource Hint}"/>
                        <CheckBox x:Name="GameEnabledBox" Content="Enabled"/>
                        <TextBlock Text="Every Y minutes while game is active" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="GameIntervalBox" Text="30"/>
                        <CheckBox x:Name="CountBox" Content="Count while merely running (no focus needed)"/>
                        <TextBlock Text="Games (one exe per line — spotify.exe = Spotify)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="GameBox" Height="70"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Text="Ignored — never counts as gameplay or sessions (one exe per line)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="IgnoreBox" Height="52"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Game time window" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Game alerts only fire inside this window. Matching, detection and confirm prompts still work outside it." Style="{StaticResource Hint}"/>
                        <CheckBox x:Name="GameWindowOnlyBox" Content="Only between times"/>
                        <StackPanel x:Name="GameTimePanel" Orientation="Horizontal">
                            <StackPanel>
                                <TextBlock Text="From (HH:mm)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="GameWindowStartBox" Width="110" Margin="0,4,8,4" Text="09:00"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="To (HH:mm)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="GameWindowEndBox" Width="110" Margin="0,4,0,4" Text="23:00"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Detect">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Right now" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="What the detector sees — read-only, refreshes every second while Settings is open." Style="{StaticResource Hint}"/>
                        <TextBlock x:Name="DetectStatusText" Text="…" TextWrapping="Wrap" FontFamily="Consolas"/>
                        <Button Content="Copy debug info" Padding="10,4" Margin="0,8,0,0" HorizontalAlignment="Left" Click="CopyDebug_Click"/>
                        <TextBlock x:Name="CopyReceiptText" FontSize="12" Foreground="#15803D" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Classify last focus" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Adds the app that was focused before Settings opened. The name is shown first, so nothing is added blind." Style="{StaticResource Hint}"/>
                        <TextBlock x:Name="ClassifyTargetText" Text="…" FontFamily="Consolas" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="To Games" Padding="10,4" Margin="0,0,8,0" Click="ClassifyGames_Click"/>
                            <Button Content="To Quiet" Padding="10,4" Margin="0,0,8,0" Click="ClassifyQuiet_Click"/>
                            <Button Content="To Ignored" Padding="10,4" Click="ClassifyIgnored_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="ClassifyReceiptText" FontSize="12" Foreground="#15803D" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Heuristics (unknown games)" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Finds unlisted games by fullscreen/GPU + idle. 30s dips never flap." Style="{StaticResource Hint}"/>
                        <CheckBox x:Name="HeurEnabledBox" Content="Enabled" IsChecked="True"/>
                        <TextBlock Text="Sustained seconds before a session starts" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="HeurStartBox" Text="60"/>
                        <TextBlock Text="Seconds of focus loss/idle before suspect" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="HeurSuspectBox" Text="30"/>
                        <TextBlock Text="Suspect minutes before session closes" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="HeurInactiveBox" Text="5"/>
                        <TextBlock Text="GPU % that counts as active" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="HeurGpuBox" Text="10"/>
                    </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Popup">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Wording" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Use {time}, {next} and {interval} — they fill in automatically." Style="{StaticResource Hint}"/>
                        <TextBlock Text="Main line" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="MainTemplateBox" Text="It is now {time}"/>
                        <TextBlock Text="Sub line" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="SubTemplateBox" Text="Next time alert in {interval} min"/>
                        <CheckBox x:Name="ShowNextBox" Content="Show sub line" IsChecked="True"/>
                        <TextBlock Text="Box stays (seconds)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="DisplayBox" Text="10"/>
                    </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Look &amp; position" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Corner, theme, colors. Custom shows extra fields." Style="{StaticResource Hint}"/>
                        <TextBlock Text="Popup corner" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="PositionBox" Margin="0,4,0,4">
                            <ComboBoxItem Content="Top left" Tag="TopLeft"/>
                            <ComboBoxItem Content="Top right" Tag="TopRight"/>
                            <ComboBoxItem Content="Bottom left" Tag="BottomLeft"/>
                            <ComboBoxItem Content="Bottom right" Tag="BottomRight"/>
                        </ComboBox>
                        <TextBlock Text="Theme" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="ThemeBox" Margin="0,4,0,4">
                            <ComboBoxItem Content="Dark" Tag="Dark"/>
                            <ComboBoxItem Content="Light" Tag="Light"/>
                            <ComboBoxItem Content="Match Windows" Tag="MatchHost"/>
                            <ComboBoxItem Content="Custom colors…" Tag="Custom"/>
                        </ComboBox>
                        <StackPanel x:Name="CustomColorPanel">
                            <TextBlock Text="Background (#AARRGGBB or #RRGGBB)" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="BgBox" Text="#CC1E1E1E" Width="220"/>
                                <Button Content="Pick…" Padding="10,2" Margin="8,4,0,4" Click="PickBg_Click"/>
                            </StackPanel>
                            <TextBlock Text="Main text color" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="TextColorBox" Text="#FFFFFFFF" Width="220"/>
                                <Button Content="Pick…" Padding="10,2" Margin="8,4,0,4" Click="PickText_Click"/>
                            </StackPanel>
                            <TextBlock Text="Sub text color" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="SubColorBox" Text="#FFBBBBBB" Width="220"/>
                                <Button Content="Pick…" Padding="10,2" Margin="8,4,0,4" Click="PickSub_Click"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Popup opacity" Style="{StaticResource FieldLabel}"/>
                        <CheckBox x:Name="ShowBoxBox" Content="Show box background (off = text floats alone)" IsChecked="True"/>
                        <TextBlock Text="Box opacity" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider x:Name="OpacitySlider" Minimum="20" Maximum="100" Width="220" Margin="0,4,8,4" TickFrequency="5" IsSnapToTickEnabled="True"/>
                            <TextBlock x:Name="OpacityLabel" Text="92%" VerticalAlignment="Center" FontSize="12" Foreground="#3A3A42"/>
                        </StackPanel>
                        <TextBlock Text="Text opacity" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider x:Name="TextOpacitySlider" Minimum="20" Maximum="100" Width="220" Margin="0,4,8,4" TickFrequency="5" IsSnapToTickEnabled="True"/>
                            <TextBlock x:Name="TextOpacityLabel" Text="100%" VerticalAlignment="Center" FontSize="12" Foreground="#3A3A42"/>
                        </StackPanel>
                        <Expander Header="Live preview" IsExpanded="False" Margin="0,8,0,0">
                            <Border x:Name="PvInlineBorder" CornerRadius="10" Padding="14,10" Margin="0,4,0,0" MaxWidth="320" HorizontalAlignment="Left">
                                <StackPanel>
                                    <TextBlock x:Name="PvInlineMain" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="PvInlineSub" FontSize="13" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Game wording" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Overrides for game reminders. Blank = default game wording." Style="{StaticResource Hint}"/>
                        <CheckBox x:Name="GameNotifyBox" Content="Pop when a game is detected"/>
                        <TextBlock Text="Game wording (blank = default game line). {game} {elapsed} {interval} {time} {next} all work here." Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="GameMainBox" Text="You have been playing {game} for {elapsed}"/>
                        <TextBlock Text="Game sub line (blank = default game sub). Same 5 tokens." Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="GameSubBox" Text="Next game alert in {interval} min"/>
                        <TextBlock Text="Detection line ({game} {interval} {time})" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="GameDetectTemplateBox" Text="{}{game} matched Games list"/>
                        <TextBlock Text="Detection sub line (blank = none). {game} {interval} {time} work here." Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="GameDetectSubBox" Text="Alerts set to {interval} min"/>
                    </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Confirm prompt" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="When an unknown game is found, ask once with Ctrl+Alt+Z/X." Style="{StaticResource Hint}"/>
                        <TextBlock Text="Wait before deciding (seconds)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="ConfirmTimeoutBox" Text="30"/>
                        <TextBlock Text="If the wait runs out" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="ConfirmActionBox" Margin="0,4,0,4">
                            <ComboBoxItem Content="Accept — track the game" Tag="Accept"/>
                            <ComboBoxItem Content="Reject — ignore it" Tag="Reject"/>
                        </ComboBox>
                    </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Try a popup" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Fire a real popup through the normal gate (Quiet/Pause still silence it)." Style="{StaticResource Hint}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Test general" Padding="10,4" Margin="0,0,8,0" Click="TestGeneral_Click"/>
                            <Button Content="Test game" Padding="10,4" Margin="0,0,8,0" Click="TestGame_Click"/>
                            <Button Content="Test confirm" Padding="10,4" Click="TestConfirm_Click"/>
                        </StackPanel>
                    </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Previews">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <TextBlock Text="Live samples of every popup, reflecting unsaved edits. Read-only — the scheduler is untouched. Game name is the first live Games line (real popup names the focused/session game); elapsed counts from when Settings was opened." Style="{StaticResource Hint}"/>
                    <TextBlock Text="1 · General reminder" Style="{StaticResource FieldLabel}"/>
                    <Border x:Name="PvGeneralBorder" CornerRadius="10" Padding="14,10" Margin="0,4,0,4" MaxWidth="320" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock x:Name="PvGeneralMain" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="PvGeneralSub" FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="2 · Game reminder" Style="{StaticResource FieldLabel}"/>
                    <Border x:Name="PvGameBorder" CornerRadius="10" Padding="14,10" Margin="0,4,0,4" MaxWidth="320" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock x:Name="PvGameMain" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="PvGameSub" FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="3 · Game detected" Style="{StaticResource FieldLabel}"/>
                    <Border x:Name="PvDetectBorder" CornerRadius="10" Padding="14,10" Margin="0,4,0,4" MaxWidth="320" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock x:Name="PvDetectMain" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="PvDetectSub" FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="4 · Confirm prompt" Style="{StaticResource FieldLabel}"/>
                    <Border x:Name="PvConfirmBorder" CornerRadius="10" Padding="14,10" Margin="0,4,0,4" MaxWidth="320" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock x:Name="PvConfirmMain" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="PvConfirmExe" FontSize="14" TextWrapping="Wrap" Visibility="Collapsed"/>
                            <TextBlock x:Name="PvConfirmSub" FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="5 · Confirm receipt — accepted" Style="{StaticResource FieldLabel}"/>
                    <Border x:Name="PvAcceptBorder" CornerRadius="10" Padding="14,10" Margin="0,4,0,4" MaxWidth="320" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock x:Name="PvAcceptMain" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="PvAcceptSub" FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="6 · Confirm receipt — rejected" Style="{StaticResource FieldLabel}"/>
                    <Border x:Name="PvRejectBorder" CornerRadius="10" Padding="14,10" Margin="0,4,0,4" MaxWidth="320" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock x:Name="PvRejectMain" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="PvRejectSub" FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Quiet">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Quiet apps" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Never pop while one of these is focused." Style="{StaticResource Hint}"/>
                        <TextBox x:Name="QuietBox" Height="120"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2">
        <TextBlock x:Name="WarnText" Foreground="#B45309" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,4"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="VersionText" VerticalAlignment="Center" FontSize="12" Foreground="#6B6B74"/>
                <Button Content="Logs" Padding="8,2" Margin="8,0,0,0" Click="OpenLogs_Click"/>
                <Button Content="Clear log" Padding="8,2" Margin="8,0,0,0" Click="ClearLog_Click"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SaveButton" Content="Save" Width="90" Padding="10,5" Margin="0,0,8,0"
                        Background="#2563EB" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Click="Save_Click"/>
                <Button x:Name="CancelButton" Content="Cancel" Width="90" Padding="10,5" Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="ErrorText" Foreground="#B91C1C" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
