<Window x:Class="TimeNotice.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        Width="320" MinHeight="90" SizeToContent="Height">
    <Border x:Name="PopupBorder" CornerRadius="10" Background="#CC1E1E1E" Padding="14,10">
        <StackPanel>
            <TextBlock x:Name="TimeText" Foreground="White" FontSize="26" FontWeight="SemiBold" Text="9:30 PM" TextWrapping="Wrap"/>
            <TextBlock x:Name="ExeText" Foreground="#FFBBBBBB" FontSize="14" TextWrapping="Wrap" Visibility="Collapsed"/>
            <TextBlock x:Name="SubText" Foreground="#FFBBBBBB" FontSize="13" Text="TimeNotice test" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>
